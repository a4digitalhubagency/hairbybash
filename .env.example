# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — get these from your Stripe dashboard
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App URL (update to your Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend
RESEND_API_KEY= your_resend_api_key
RESEND_ADMIN_EMAIL=   your_admin_email
RESEND_FROM_EMAIL= your_from_email
# Scheduled jobs — shared secret for /api/cron/*
# Generate with: openssl rand -hex 32
# Must also be set as the CRON_SECRET repository secret in GitHub Actions,
# alongside APP_URL (your production URL, no trailing slash).
CRON_SECRET=
